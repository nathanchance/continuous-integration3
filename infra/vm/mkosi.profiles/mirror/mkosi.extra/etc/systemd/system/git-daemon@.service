[Unit]
Description=Git Daemon Instance

[Service]
User=git
ExecStart=-/usr/lib/git-core/git-daemon --inetd --export-all --base-path=/srv/git --informative-errors --verbose /srv/git
StandardInput=socket
StandardOutput=inherit
StandardError=journal
ProtectSystem=full
ProtectHome=on
PrivateDevices=on
NoNewPrivileges=on
